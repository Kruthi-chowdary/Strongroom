{
  "name": "strongroom",
  "version": "0.1.0",
  "description": "Secure document-sharing platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc && copy src\\schema.sql dist\\schema.sql",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:auth": "vitest run tests/authorize.test.ts",
    "seed": "ts-node src/seed.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.6",
    "express": "^4.18.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^7.1.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.8",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.43",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^9.0.8",
    "supertest": "^7.3.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.1"
  }
}
