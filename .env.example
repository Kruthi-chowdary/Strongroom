# Strongroom – environment variables
# Copy to .env and fill in real values. Never commit .env to version control.

# HTTP port the server listens on
PORT=3000

# Secret used to sign the session cookie (httpOnly, SameSite=Strict).
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace_with_64_byte_random_hex

# 32-byte hex key used for AES-256 encryption of files at rest (Rule 6).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FILE_ENCRYPTION_KEY=replace_with_32_byte_random_hex

# Optional: override the default SQLite file path (default: ./strongroom.db)
# DB_PATH=/data/strongroom.db
